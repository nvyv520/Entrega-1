# Copy to .env.cloud on the server and replace the example values.
# Public browser origin, without a trailing slash. Use HTTPS for the public deployment.
PUBLIC_URL=https://siga.example.com
HTTP_PORT=80

DB_NAME=siga
DB_USER=siga
DB_PASSWORD=replace-with-a-database-password

# Use validate during normal operation; initialize a new schema with one instance first.
DDL_AUTO=validate
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=replace-with-a-keycloak-admin-password

# Use the ID and secret of the service account in your imported SIGA realm.
KEYCLOAK_ADMIN_CLIENT_ID=siga-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-the-imported-client-secret

# Enable after checking the siga-backend audience mapper in the imported realm.
KEYCLOAK_VALIDATE_AUDIENCE=false

# Prefer matching commit tags for both images after publishing these changes.
BACKEND_IMAGE=nvyv520/siga-backend:latest
FRONTEND_IMAGE=nvyv520/siga-frontend:latest
